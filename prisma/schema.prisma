// Schéma Prisma — Plateforme de gestion Odysseo Education
// Postgres. Voir DOCUMENTATION.md pour le détail du modèle métier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTIFICATION (staff / admin) — compatible Auth.js v5
// ============================================================

enum StaffRole {
  ADMIN
  STAFF
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String? // null si l'utilisateur ne se connecte que via Google
  role              StaffRole @default(STAFF)

  // 2FA (TOTP — Google Authenticator / Authy...)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String? // secret TOTP chiffré côté applicatif

  accounts          Account[]
  sessions          Session[]
  notificationPrefs NotificationPreference?
  passwordResetTokens PasswordResetToken[]

  // Notifications in-app : tout ce qui est plus récent est "non lu" pour cet utilisateur.
  notificationsSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Réinitialisation du mot de passe par lien email : on ne stocke que l'empreinte
// SHA-256 du jeton (le jeton en clair n'existe que dans l'email), valable 1 h, usage unique.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// PROGRAMME PARTENAIRES (parrainage + points)
// Remplace l'idée de "signature manuscrite" par un code de parrainage
// traçable, horodaté et vérifiable automatiquement.
// ============================================================

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

model Partner {
  id          String        @id @default(cuid())
  fullName    String
  email       String        @unique
  phone       String?
  referralCode String       @unique // ex. AUDY-012, utilisé en ?ref= ou /r/CODE
  status      PartnerStatus @default(ACTIVE)
  pointsBalance Int         @default(0)

  candidates       Candidate[]
  referralEvents   ReferralEvent[]
  pointsLedger     PointsLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

// Chaque clic sur un lien de parrainage (avant même la soumission du formulaire)
enum ReferralEventType {
  LINK_CLICK
  FORM_SUBMITTED
}

model ReferralEvent {
  id        String            @id @default(cuid())
  partnerId String
  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      ReferralEventType
  candidateId String?
  candidate   Candidate?      @relation(fields: [candidateId], references: [id])
  userAgent String?
  createdAt DateTime          @default(now())

  @@map("referral_events")
}

enum PointsReason {
  NEW_LEAD        // nouveau dossier apporté
  QUALIFIED_LEAD  // dossier passé au statut "qualifié"
  ENROLLED        // étudiant inscrit / admis
  MANUAL_ADJUSTMENT
}

model PointsLedgerEntry {
  id        String       @id @default(cuid())
  partnerId String
  partner   Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  points    Int // peut être négatif (ajustement)
  reason    PointsReason
  note      String?
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  createdAt DateTime     @default(now())

  @@map("points_ledger_entries")
}

// ============================================================
// CANDIDATS (dossiers collectés via le formulaire public)
// Reprend les champs du formulaire actuel (étapes Vous / Parcours / Projet / Validation)
// ============================================================

enum CandidatePipelineStatus {
  NOUVEAU
  QUALIFIE
  DOSSIER_EN_COURS
  BOURSE_SOUMISE
  ADMIS
  VISA_EN_COURS
  CLOTURE
  REFUSE
}

model Candidate {
  id   String @id @default(cuid())
  code String @unique // code dossier affiché à l'étudiant, ex. ODY-2BQ9X1

  // Étape 1 — Vous
  fullName       String
  whatsapp       String
  email          String? // facultatif en base : les dossiers antérieurs à la v1.1 n'en ont pas
  dateOfBirth    DateTime
  age            Int?
  country        String
  city           String
  managedBy      String // "self" | "parent" | "guardian"
  guardianName   String?
  guardianLink   String?
  guardianWhatsapp String?

  // Étape 2 — Parcours
  currentSituation String?
  highestDegree    String
  degreeYear       Int?
  degreeAverage    String?

  // Étape 3 — Projet
  targetLevel      String
  fieldOfStudy     String
  passportStatus   String
  englishLevel     String
  fundingPlan      String
  targetIntake     String

  // Étape 4 — Validation / source
  referredByPartnerDeclared String? // code tapé librement par le candidat
  discoverySource           String? // TikTok, Facebook, Ami/famille...
  consentGiven              Boolean  @default(false)
  submissionDurationSec     Int?

  // Pipeline interne
  status       CandidatePipelineStatus @default(NOUVEAU)
  assignedToId String?
  internalNotes String? @db.Text

  // Attribution de source (programme partenaires)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  srcParam  String? // valeur brute de ?ref= / ?src= à la soumission

  referralEvents     ReferralEvent[]
  pointsLedgerEntries PointsLedgerEntry[]
  notificationLogs   NotificationLog[]

  locale String @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidates")
}

// ============================================================
// NEWSLETTER
// ============================================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============================================================
// NOTIFICATIONS (email / whatsapp / push)
// ============================================================

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  SKIPPED // canal non configuré ou personne à notifier : rien n'est parti
  FAILED
}

model NotificationLog {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  recipient   String
  subject     String?
  error       String?
  candidateId String?
  candidate   Candidate?          @relation(fields: [candidateId], references: [id])
  createdAt   DateTime            @default(now())

  @@map("notification_logs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOnNewLead Boolean @default(true)
  pushOnNewLead  Boolean @default(true)

  @@map("notification_preferences")
}

// ============================================================
// CONSENTEMENT COOKIES (journal, à des fins de preuve RGPD)
// ============================================================

model CookieConsentLog {
  id         String   @id @default(cuid())
  anonId     String // identifiant anonyme côté navigateur
  necessary  Boolean  @default(true)
  analytics  Boolean  @default(false)
  marketing  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("cookie_consent_logs")
}
