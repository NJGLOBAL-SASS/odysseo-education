// Schéma Prisma — Plateforme de gestion Odysseo Education
// Postgres. Voir DOCUMENTATION.md pour le détail du modèle métier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTIFICATION (staff / admin) — compatible Auth.js v5
// ============================================================

enum StaffRole {
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null si l'utilisateur ne se connecte que via Google
  role          StaffRole @default(STAFF)

  // 2FA (TOTP — Google Authenticator / Authy...)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // secret TOTP chiffré côté applicatif

  accounts            Account[]
  sessions            Session[]
  notificationPrefs   NotificationPreference?
  passwordResetTokens PasswordResetToken[]

  // Notifications in-app : tout ce qui est plus récent est "non lu" pour cet utilisateur.
  notificationsSeenAt DateTime?
  // Compteurs de la sidebar : nouveautés depuis la dernière visite de chaque section.
  candidatesSeenAt    DateTime?
  newsletterSeenAt    DateTime?

  partnerApplicationsReviewed PartnerApplication[] @relation("ApplicationReviewer")
  candidateMessagesSent       CandidateMessage[]
  pointsEntriesCreated        PointsLedgerEntry[]
  documentFoldersCreated      DocumentFolder[]
  documentFilesUploaded       DocumentFile[]
  documentActivities          DocumentActivity[]
  portalAccountsCreated       PortalAccount[]
  portalMessagesSent          PortalMessage[]
  documentFoldersApproved     DocumentFolder[]     @relation("DocumentFolderApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Réinitialisation du mot de passe par lien email : on ne stocke que l'empreinte
// SHA-256 du jeton (le jeton en clair n'existe que dans l'email), valable 1 h, usage unique.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// PROGRAMME PARTENAIRES (parrainage + points)
// Remplace l'idée de "signature manuscrite" par un code de parrainage
// traçable, horodaté et vérifiable automatiquement.
// ============================================================

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

model Partner {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  phone         String?
  referralCode  String        @unique // ex. AUDY-012, utilisé en ?ref= ou /r/CODE
  status        PartnerStatus @default(ACTIVE)
  pointsBalance Int           @default(0)

  candidates     Candidate[]
  referralEvents ReferralEvent[]
  pointsLedger   PointsLedgerEntry[]
  application    PartnerApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

// Demande de partenariat envoyée depuis le site public (/partenaires), examinée
// par l'équipe dans le dashboard ; le demandeur est informé de la décision par email.
enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerApplication {
  id         String @id @default(cuid())
  fullName   String
  email      String
  whatsapp   String
  country    String
  city       String
  profile    String // student | teacher | agency | creator | other
  motivation String @db.Text
  locale     String @default("fr")

  status       PartnerApplicationStatus @default(PENDING)
  responseNote String?                  @db.Text // message envoyé au demandeur avec la décision
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                    @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Partenaire créé lors de l'acceptation
  partnerId String?  @unique
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("partner_applications")
}

// Chaque clic sur un lien de parrainage (avant même la soumission du formulaire)
enum ReferralEventType {
  LINK_CLICK
  FORM_SUBMITTED
}

model ReferralEvent {
  id          String            @id @default(cuid())
  partnerId   String
  partner     Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type        ReferralEventType
  candidateId String?
  candidate   Candidate?        @relation(fields: [candidateId], references: [id])
  userAgent   String?
  createdAt   DateTime          @default(now())

  @@map("referral_events")
}

enum PointsReason {
  NEW_LEAD // nouveau dossier apporté
  QUALIFIED_LEAD // dossier passé au statut "qualifié"
  ENROLLED // étudiant inscrit / admis
  MANUAL_ADJUSTMENT
}

// Journal des points : le solde du partenaire est la somme de ses lignes.
// Une ligne négative est un retrait (dossier rétrogradé, ajustement manuel) :
// on n'efface jamais une ligne, on la compense.
model PointsLedgerEntry {
  id           String       @id @default(cuid())
  partnerId    String
  partner      Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  points       Int // positif = ajout, négatif = retrait
  reason       PointsReason
  note         String?
  candidateId  String?
  candidate    Candidate?   @relation(fields: [candidateId], references: [id])
  balanceAfter Int? // solde du partenaire juste après cette ligne (null pour les lignes antérieures à la v1.3)
  createdById  String? // null = automatique (soumission, changement de statut par l'API publique)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([partnerId, createdAt])
  @@index([candidateId])
  @@map("points_ledger_entries")
}

// ============================================================
// CANDIDATS (dossiers collectés via le formulaire public)
// Reprend les champs du formulaire actuel (étapes Vous / Parcours / Projet / Validation)
// ============================================================

enum CandidatePipelineStatus {
  NOUVEAU
  QUALIFIE
  DOSSIER_EN_COURS
  BOURSE_SOUMISE
  ADMIS
  VISA_EN_COURS
  CLOTURE
  REFUSE
}

model Candidate {
  id   String @id @default(cuid())
  code String @unique // code dossier affiché à l'étudiant, ex. ODY-2BQ9X1

  // Étape 1 — Vous
  fullName         String
  whatsapp         String
  email            String? // facultatif en base : les dossiers antérieurs à la v1.1 n'en ont pas
  dateOfBirth      DateTime
  age              Int?
  country          String
  city             String
  managedBy        String // "self" | "parent" | "guardian"
  guardianName     String?
  guardianLink     String?
  guardianWhatsapp String?

  // Étape 2 — Parcours
  currentSituation String?
  highestDegree    String
  degreeYear       Int?
  degreeAverage    String?
  // PACK-01 (facultatifs : les dossiers antérieurs ne les ont pas). Noms du pack entre parenthèses.
  degreeField      String? // filière du diplôme (filiereDiplome)
  averageValue     Float? // moyenne saisie (moyenneValeur)
  averageScale     String? // "20" | "100" | "4" | "5" | "unknown" (moyenneBareme)
  averagePct       Float? // moyenne ramenée sur 100 (moyenne_pct), null si barème inconnu
  originalDiplomas Boolean? // diplômes originaux : true = Oui, false = Pas encore (diplomesOriginaux)

  // Étape 3 — Projet
  targetLevel         String
  fieldOfStudy        String
  passportStatus      String
  englishLevel        String
  fundingPlan         String
  targetIntake        String
  // PACK-01 (facultatifs). fieldOfStudy garde les libellés lisibles, studyFields les codes.
  studyFields         String[] @default([]) // codes des domaines, 2 max (domaines[])
  englishCertificate  String? // "ielts" | "toefl" | "duolingo" | "studiedInEnglish" | "none" (anglaisCertificat)
  englishScore        Float? // score du certificat (anglaisScore)
  hskLevel            Int? // 0 à 6, HSK 1-2 → 2 (hsk)
  bankStatement       String? // tranche choisie (releveBancaire)
  bankStatementUsdMax Int? // 0 | 2500 | 5000 | 10000 | null (releve_bancaire_usd_max)

  // Étape 4 — Validation / source
  referredByPartnerDeclared String? // code tapé librement par le candidat
  discoverySource           String? // TikTok, Facebook, Ami/famille...
  consentGiven              Boolean @default(false)
  submissionDurationSec     Int?

  // Pipeline interne
  status        CandidatePipelineStatus @default(NOUVEAU)
  assignedToId  String?
  internalNotes String?                 @db.Text

  // Attribution de source (programme partenaires)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  srcParam  String? // valeur brute de ?ref= / ?src= à la soumission

  // Attribution « premier contact » (PACK-04) : publicité, campagne, référence d'offre.
  // Capturée dans l'URL à la première visite (localStorage odysseo_attribution). Pas de donnée personnelle.
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  fbclid           String?
  offerRef         String? // code d'offre de la publicité, ex. P-04, MA-07
  landingPage      String? // page d'arrivée de la première visite
  firstVisitAt     DateTime?
  marketingConsent Boolean   @default(false) // consentement cookies « marketing » au moment de l'envoi

  // Moteur « Vos 3 offres » (PACK-02) : offres proposées à l'envoi, références anonymes.
  recommendations Json? // [{ ref: "MA-26", role: "ambitieuse" | "cible" | "securite" }] (recommandations)
  matchingVersion String? // version du catalogue, ex. 2027.09-v2 (moteur_version)

  // Suivi en ligne (PACK-08) : étape visible par l'étudiant sur /suivi (distincte du statut interne).
  stage          String    @default("recu") // recu | analyse | ouvert | documents | depose | admis | visa | depart | arrive | en_attente_etudiant | clos (etape)
  stageUpdatedAt DateTime? // etape_maj_le
  stageHistory   Json      @default("[]") // [{ stage, date }] (historique_etapes)
  publicNote     String?   @db.VarChar(200) // note_publique, visible par l'étudiant

  referralEvents      ReferralEvent[]
  pointsLedgerEntries PointsLedgerEntry[]
  notificationLogs    NotificationLog[]
  messages            CandidateMessage[]
  documentFolders     DocumentFolder[]
  portalAccounts      PortalAccount[]
  portalMessages      PortalMessage[]
  documentActivities  DocumentActivity[]

  locale String @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidates")
}

// ============================================================
// NEWSLETTER
// ============================================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============================================================
// NOTIFICATIONS (email / whatsapp / push)
// ============================================================

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  SKIPPED // canal non configuré ou personne à notifier : rien n'est parti
  FAILED
}

model NotificationLog {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  recipient   String
  subject     String?
  error       String?
  candidateId String?
  candidate   Candidate?          @relation(fields: [candidateId], references: [id])
  createdAt   DateTime            @default(now())

  @@map("notification_logs")
}

// Email rédigé dans le dashboard et envoyé au candidat (historique sur sa fiche).
/// Compteur d'essais (empreintes, jamais d'IP en clair) : connexions à l'espace étudiant,
/// demandes de mot de passe oublié. Lignes purgées après 24 h.
model TrackingAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ============================================================
// ESPACE ÉTUDIANT (odysseo-application.vercel.app)
// Comptes créés par l'équipe ; connexion e-mail + mot de passe ou Google.
// ============================================================

enum PortalRole {
  STUDENT
  PARENT
}

model PortalAccount {
  id             String     @id @default(cuid())
  candidateId    String
  candidate      Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  role           PortalRole @default(STUDENT)
  email          String     @unique
  name           String
  passwordHash   String? // null tant que le lien d'activation n'a pas servi (Google reste possible)
  locale         String     @default("fr")
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  disabledAt     DateTime?
  sessionVersion Int        @default(0) // +1 : déconnecte tous les appareils (mot de passe changé, compte désactivé)
  createdById    String?
  createdBy      User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tokens          PortalToken[]
  messages        PortalMessage[]
  documentFolders DocumentFolder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@map("portal_accounts")
}

/// Liens à usage unique envoyés par e-mail : activation (invite) ou mot de passe oublié (reset).
model PortalToken {
  id        String        @id @default(cuid())
  accountId String
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String // invite | reset
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@map("portal_tokens")
}

enum MessageAuthor {
  TEAM
  STUDENT
  PARENT
}

/// Messagerie d'un dossier entre l'équipe et l'étudiant / le parent.
model PortalMessage {
  id                String         @id @default(cuid())
  candidateId       String
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorType        MessageAuthor
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  portalAccountId   String?
  portalAccount     PortalAccount? @relation(fields: [portalAccountId], references: [id], onDelete: SetNull)
  authorName        String // nom affiché au moment de l'envoi
  body              String         @db.Text
  readByTeamAt      DateTime?
  readByCandidateAt DateTime?
  createdAt         DateTime       @default(now())

  @@index([candidateId, createdAt])
  @@map("portal_messages")
}

model CandidateMessage {
  id          String             @id @default(cuid())
  candidateId String
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  subject     String
  html        String             @db.Text // HTML déjà nettoyé (liste blanche de balises)
  attachments Json               @default("[]") // [{ name, size, type }] — les fichiers eux-mêmes ne sont pas stockés
  sentById    String?
  sentBy      User?              @relation(fields: [sentById], references: [id], onDelete: SetNull)
  status      NotificationStatus @default(PENDING)
  error       String?
  createdAt   DateTime           @default(now())

  @@index([candidateId, createdAt])
  @@map("candidate_messages")
}

model PushSubscription {
  id              String   @id @default(cuid())
  userId          String?
  portalAccountId String? // appareil de l'espace étudiant (jamais destinataire des alertes équipe)
  endpoint        String   @unique
  p256dh          String
  auth            String
  createdAt       DateTime @default(now())

  @@map("push_subscriptions")
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOnNewLead Boolean @default(true)
  pushOnNewLead  Boolean @default(true)

  @@map("notification_preferences")
}

// ============================================================
// CONSENTEMENT COOKIES (journal, à des fins de preuve RGPD)
// ============================================================

model CookieConsentLog {
  id        String   @id @default(cuid())
  anonId    String // identifiant anonyme côté navigateur
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("cookie_consent_logs")
}

// ============================================================
// DOCUMENTS (pièces des dossiers candidats + espace « Données » interne)
// Fichiers stockés en privé sur Vercel Blob : jamais d'URL publique, tout
// passe par /api/documents/files/[id] (session obligatoire + journal).
// ============================================================

// Un lot de fichiers envoyé en une fois : « Passeport » (2 scans), « Relevés de notes »...
// candidateId null = document interne à l'entreprise (espace Données).
model DocumentFolder {
  id          String     @id @default(cuid())
  kind        String // passport | transcript | ... (voir src/lib/documents.ts)
  title       String
  description String?    @db.Text
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Espace étudiant : un lot envoyé par l'étudiant / le parent lui reste visible ; un lot de
  // l'équipe reste privé tant qu'un membre ne l'a pas approuvé (« Approuver et rendre visible »).
  visibleToCandidate Boolean        @default(false)
  approvedById       String?
  approvedBy         User?          @relation("DocumentFolderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  uploadedByPortalId String?
  uploadedByPortal   PortalAccount? @relation(fields: [uploadedByPortalId], references: [id], onDelete: SetNull)

  files      DocumentFile[]
  activities DocumentActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, createdAt])
  @@map("document_folders")
}

model DocumentFile {
  id                 String         @id @default(cuid())
  folderId           String
  folder             DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name               String // nom d'origine, affiché et proposé au téléchargement
  size               Int
  contentType        String
  blobUrl            String         @unique
  uploadedById       String?
  uploadedBy         User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByPortalId String? // envoyé depuis l'espace étudiant (PortalAccount.id)

  activities DocumentActivity[]

  createdAt DateTime @default(now())

  @@index([folderId])
  @@map("document_files")
}

enum DocumentAction {
  UPLOAD
  VIEW
  DOWNLOAD
  UPDATE
  DELETE_FILE
  DELETE_FOLDER
}

// Traçabilité : qui a envoyé, ouvert, téléchargé ou supprimé quoi, et quand.
// Les noms sont recopiés pour que le journal reste lisible après une suppression.
model DocumentActivity {
  id              String          @id @default(cuid())
  action          DocumentAction
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  portalAccountId String? // action faite depuis l'espace étudiant
  actorName       String? // nom ou email au moment de l'action
  folderId        String?
  folder          DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileId          String?
  file            DocumentFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  candidateId     String?
  candidate       Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  folderTitle     String
  fileName        String?
  ip              String?
  userAgent       String?
  createdAt       DateTime        @default(now())

  @@index([createdAt])
  @@index([candidateId, createdAt])
  @@index([folderId, createdAt])
  @@map("document_activities")
}
